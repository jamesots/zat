{
  "name": "zat",
  "version": "0.2.0",
  "description": "Z80 Automated Testing: unit test Z80 assembly code from TypeScript or JavaScript",
  "keywords": [
    "z80",
    "assembly",
    "assembler",
    "emulator",
    "testing",
    "unit-test",
    "tdd",
    "retro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesots/zat.git"
  },
  "homepage": "https://github.com/jamesots/zat#readme",
  "bugs": {
    "url": "https://github.com/jamesots/zat/issues"
  },
  "main": "lib/zat.js",
  "types": "lib/zat.d.ts",
  "files": [
    "lib",
    "src/vendor/README.md",
    "src/vendor/*/LICENSE",
    "CHANGELOG.md",
    "DOCS.md"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc",
    "tsc": "tsc",
    "test": "tsc -p spec && vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prepublishOnly": "npm run build && npm test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  },
  "author": "James Ots <code@jamesots.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "z80-test": "2.0.1"
  },
  "dependencies": {
    "maz": "^0.6.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
